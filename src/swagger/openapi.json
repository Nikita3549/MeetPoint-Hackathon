{
  "openapi": "3.0.3",
  "info": {
    "title": "Hackaton Prod API",
    "description": "Backend API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "Current server"
    }
  ],
  "tags": [
    {
      "name": "health",
      "description": "Health checks"
    },
    {
      "name": "auth",
      "description": "Authentication"
    },
    {
      "name": "events",
      "description": "Events (JWT required)"
    },
    {
      "name": "users",
      "description": "Users (JWT required)"
    },
    {
      "name": "images",
      "description": "Image uploads (avatar, event cover)"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["health"],
        "summary": "Health check",
        "operationId": "healthCheck",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/login": {
      "post": {
        "tags": ["auth"],
        "summary": "Login",
        "description": "Authenticate with email and password. Returns a JWT access token.",
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful login",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedInvalidCredentials"
          }
        }
      }
    },
    "/v1/events": {
      "get": {
        "tags": ["events"],
        "summary": "List all events",
        "operationId": "listEvents",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "List of events",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EventResponse"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "tags": ["events"],
        "summary": "Create event",
        "description": "Requires ORGANIZER role",
        "operationId": "createEvent",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEventRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Event created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenOrganizer"
          }
        }
      }
    },
    "/v1/events/slug/{slug}": {
      "get": {
        "tags": ["events"],
        "summary": "Get event by join link code",
        "operationId": "getEventBySlug",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "description": "Event link code (format: abc-defg-hij)",
            "schema": {
              "type": "string",
              "pattern": "^[a-z]{3}-[a-z]{4}-[a-z]{3}$",
              "example": "abc-defg-hij"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Event found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundEvent"
          }
        }
      }
    },
    "/v1/events/slug/{slug}/register": {
      "post": {
        "tags": ["events"],
        "summary": "Register for event by join link code",
        "operationId": "registerForEventBySlug",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z]{3}-[a-z]{4}-[a-z]{3}$",
              "example": "abc-defg-hij"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Registered for event",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventRegistrationResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundEvent"
          }
        }
      }
    },
    "/v1/events/{id}": {
      "get": {
        "tags": ["events"],
        "summary": "Get event by id",
        "operationId": "getEventById",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Event found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundEvent"
          }
        }
      },
      "put": {
        "tags": ["events"],
        "summary": "Update event",
        "description": "Requires ORGANIZER role and event ownership",
        "operationId": "updateEvent",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateEventRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Event updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenOrganizer"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundEvent"
          }
        }
      }
    },
    "/v1/events/{id}/register": {
      "post": {
        "tags": ["events"],
        "summary": "Register for event",
        "operationId": "registerForEvent",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Registered for event",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventRegistrationResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundEvent"
          }
        }
      }
    },
    "/v1/events/{id}/image": {
      "post": {
        "tags": ["events", "images"],
        "summary": "Upload event cover image",
        "description": "Organizer only. Owner of the event can upload a cover image (max 5 MB).",
        "operationId": "uploadEventCoverImage",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/ImageUploadRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cover image uploaded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventResponse"
                },
                "example": {
                  "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                  "slug": "abc-defg-hij",
                  "joinUrl": "https://meetpoint.app/e/abc-defg-hij",
                  "title": "Tech Conference 2026",
                  "date": "2026-06-15T10:00:00.000Z",
                  "description": "Annual networking event for developers",
                  "imageUrl": "https://res.cloudinary.com/demo/image/upload/prod_images/cover.jpg",
                  "organizer": {
                    "id": "b2c3d4e5-f6a7-8901-bcde-f12345678901",
                    "fullName": "Jane Organizer"
                  },
                  "tags": [{ "id": "c3d4e5f6-a7b8-9012-cdef-123456789012", "name": "frontend" }],
                  "createdAt": "2026-05-15T12:00:00.000Z",
                  "updatedAt": "2026-05-16T08:00:00.000Z"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestImage"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenOrganizer"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundEvent"
          }
        }
      }
    },
    "/v1/users/me/contacts": {
      "get": {
        "tags": ["users"],
        "summary": "List current user contacts",
        "operationId": "getUserContacts",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "User contacts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UserContactResponse"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "put": {
        "tags": ["users"],
        "summary": "Set current user contacts",
        "operationId": "setUserContacts",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetUserContactsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Contacts updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UserContactResponse"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/users/me/avatar": {
      "post": {
        "tags": ["users", "images"],
        "summary": "Upload current user avatar",
        "description": "Any authenticated user can upload or replace their avatar (max 5 MB).",
        "operationId": "uploadUserAvatar",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/ImageUploadRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Avatar uploaded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserAvatarResponse"
                },
                "example": {
                  "avatarUrl": "https://res.cloudinary.com/demo/image/upload/prod_images/photo.jpg"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestImage"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad request — validation failed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "statusCode": 400,
              "message": ["title must be longer than or equal to 1 characters"],
              "error": "Bad Request"
            }
          }
        }
      },
      "BadRequestImage": {
        "description": "Bad request — invalid or missing image file",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "statusCode": 400,
              "message": "Only image files are allowed",
              "error": "Bad Request"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Unauthorized — missing or invalid JWT",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "statusCode": 401,
              "message": "Unauthorized",
              "error": "Unauthorized"
            }
          }
        }
      },
      "UnauthorizedInvalidCredentials": {
        "description": "Unauthorized — invalid email or password",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "statusCode": 401,
              "message": "Invalid credentials",
              "error": "Unauthorized"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Forbidden — insufficient permissions",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "statusCode": 403,
              "message": "Forbidden resource",
              "error": "Forbidden"
            }
          }
        }
      },
      "ForbiddenOrganizer": {
        "description": "Forbidden — ORGANIZER role or event ownership required",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "statusCode": 403,
              "message": "Forbidden resource",
              "error": "Forbidden"
            }
          }
        }
      },
      "NotFound": {
        "description": "Not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "statusCode": 404,
              "message": "Not Found",
              "error": "Not Found"
            }
          }
        }
      },
      "NotFoundEvent": {
        "description": "Not found — event does not exist",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "statusCode": 404,
              "message": "Event not found",
              "error": "Not Found"
            }
          }
        }
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "example": "password123"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "required": ["accessToken"],
        "properties": {
          "accessToken": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["statusCode", "message"],
        "properties": {
          "statusCode": {
            "type": "integer",
            "description": "HTTP status code"
          },
          "message": {
            "oneOf": [
              { "type": "string" },
              { "type": "array", "items": { "type": "string" } }
            ],
            "description": "Error message or validation errors list"
          },
          "error": {
            "type": "string",
            "description": "HTTP error name"
          }
        }
      },
      "ImageUploadRequest": {
        "type": "object",
        "required": ["file"],
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "description": "Image file (JPEG, PNG, GIF, WebP, SVG, BMP, TIFF). Max 5 MB."
          }
        },
        "example": {
          "file": "photo.jpg"
        }
      },
      "EventTag": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "frontend"
          }
        }
      },
      "EventOrganizer": {
        "type": "object",
        "required": ["id", "fullName"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "fullName": {
            "type": "string",
            "example": "Jane Organizer"
          }
        }
      },
      "EventResponse": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "joinUrl",
          "title",
          "date",
          "description",
          "organizer",
          "tags",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string",
            "example": "abc-defg-hij"
          },
          "joinUrl": {
            "type": "string",
            "format": "uri",
            "example": "https://meetpoint.app/e/abc-defg-hij"
          },
          "title": {
            "type": "string",
            "example": "Tech Conference 2026"
          },
          "date": {
            "type": "string",
            "format": "date-time",
            "example": "2026-06-15T10:00:00.000Z"
          },
          "description": {
            "type": "string",
            "example": "Annual networking event for developers"
          },
          "imageUrl": {
            "type": "string",
            "format": "uri",
            "nullable": true,
            "example": "https://res.cloudinary.com/demo/image/upload/prod_images/cover.jpg"
          },
          "organizer": {
            "$ref": "#/components/schemas/EventOrganizer"
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventTag"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateEventRequest": {
        "type": "object",
        "required": ["title", "date", "description", "tags"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "example": "Tech Conference 2026"
          },
          "date": {
            "type": "string",
            "format": "date-time",
            "example": "2026-06-15T10:00:00.000Z"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "example": "Annual networking event for developers"
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "example": ["frontend", "backend", "AI"]
          }
        }
      },
      "UpdateEventRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "example": "Tech Conference 2026"
          },
          "date": {
            "type": "string",
            "format": "date-time",
            "example": "2026-06-15T10:00:00.000Z"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "example": "Annual networking event for developers"
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "example": ["frontend", "backend"]
          }
        }
      },
      "EventRegistrationResponse": {
        "type": "object",
        "required": ["id", "eventId", "userId", "registeredAt"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "registeredAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ContactType": {
        "type": "string",
        "enum": ["TELEGRAM", "EMAIL", "PHONE"]
      },
      "UserContactItem": {
        "type": "object",
        "required": ["type", "value"],
        "properties": {
          "type": {
            "$ref": "#/components/schemas/ContactType"
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "example": "@username"
          }
        }
      },
      "SetUserContactsRequest": {
        "type": "object",
        "required": ["contacts"],
        "properties": {
          "contacts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserContactItem"
            }
          }
        }
      },
      "UserContactResponse": {
        "type": "object",
        "required": ["id", "type", "value", "createdAt", "updatedAt"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "$ref": "#/components/schemas/ContactType"
          },
          "value": {
            "type": "string",
            "example": "@username"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UserAvatarResponse": {
