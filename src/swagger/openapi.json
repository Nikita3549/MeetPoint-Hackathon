{
  "openapi": "3.0.3",
  "info": {
    "title": "Hackaton Prod API",
    "description": "Backend API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "Current server"
    }
  ],
  "tags": [
    {
      "name": "health",
      "description": "Health checks"
    },
    {
      "name": "auth",
      "description": "Authentication"
    },
    {
      "name": "events",
      "description": "Events (JWT required)"
    },
    {
      "name": "users",
      "description": "Users (JWT required)"
    },
    {
      "name": "images",
      "description": "Image uploads (avatar, event cover)"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["health"],
        "summary": "Health check",
        "operationId": "healthCheck",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/login": {
      "post": {
        "tags": ["auth"],
        "summary": "Login",
        "description": "Authenticate with email and password. Returns a JWT access token.",
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful login",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedInvalidCredentials"
          }
        }
      }
    },
    "/v1/auth/register": {
      "post": {
        "tags": ["auth"],
        "summary": "Register",
        "description": "Create an account with email and password. Returns a JWT access token (same response as login).",
        "operationId": "register",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful registration",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/ConflictEmailRegistered"
          }
        }
      }
    },
    "/v1/events": {
      "get": {
        "tags": ["events"],
        "summary": "List all events",
        "operationId": "listEvents",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "List of events",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EventResponse"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "tags": ["events"],
        "summary": "Create event",
        "description": "Requires ORGANIZER role",
        "operationId": "createEvent",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEventRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Event created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenOrganizer"
          }
        }
      }
    },
    "/v1/events/slug/{slug}": {
      "get": {
        "tags": ["events"],
        "summary": "Get event by join link code",
        "operationId": "getEventBySlug",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "description": "Event link code (format: abc-defg-hij)",
            "schema": {
              "type": "string",
              "pattern": "^[a-z]{3}-[a-z]{4}-[a-z]{3}$",
              "example": "abc-defg-hij"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Event found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestSlug"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundEvent"
          }
        }
      }
    },
    "/v1/events/slug/{slug}/register": {
      "post": {
        "tags": ["events"],
        "summary": "Register for event by join link code",
        "operationId": "registerForEventBySlug",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z]{3}-[a-z]{4}-[a-z]{3}$",
              "example": "abc-defg-hij"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Registered for event",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventRegistrationResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestSlug"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundEvent"
          }
        }
      }
    },
    "/v1/events/{id}": {
      "get": {
        "tags": ["events"],
        "summary": "Get event by id",
        "operationId": "getEventById",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Event found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundEvent"
          }
        }
      },
      "put": {
        "tags": ["events"],
        "summary": "Update event",
        "description": "Requires ORGANIZER role and event ownership",
        "operationId": "updateEvent",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateEventRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Event updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenEventOwner"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundEvent"
          }
        }
      }
    },
    "/v1/events/{id}/register": {
      "post": {
        "tags": ["events"],
        "summary": "Register for event",
        "operationId": "registerForEvent",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Registered for event",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventRegistrationResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundEvent"
          }
        }
      }
    },
    "/v1/events/{id}/image": {
      "post": {
        "tags": ["images", "events"],
        "summary": "Upload event cover image",
        "operationId": "uploadEventCoverImage",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/ImageUploadRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventResponse"
                },
                "example": {
                  "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                  "slug": "abc-defg-hij",
                  "joinUrl": "https://meetpoint.app/e/abc-defg-hij",
                  "title": "Tech Conference 2026",
                  "date": "2026-06-15T10:00:00.000Z",
                  "description": "Annual networking event for developers",
                  "imageUrl": "https://res.cloudinary.com/demo/image/upload/prod_images/cover.jpg",
                  "organizer": {
                    "id": "b2c3d4e5-f6a7-8901-bcde-f12345678901",
                    "fullName": "Jane Organizer"
                  },
                  "tags": [
                    {
                      "id": "c3d4e5f6-a7b8-9012-cdef-123456789012",
                      "name": "frontend"
                    }
                  ],
                  "createdAt": "2026-05-15T12:00:00.000Z",
                  "updatedAt": "2026-05-16T08:00:00.000Z"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestImage"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenEventOwner"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundEvent"
          }
        }
      }
    },
    "/v1/users/me/contacts": {
      "get": {
        "tags": ["users"],
        "summary": "List current user contacts",
        "operationId": "getUserContacts",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "User contacts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UserContactResponse"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "put": {
        "tags": ["users"],
        "summary": "Set current user contacts",
        "operationId": "setUserContacts",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetUserContactsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Contacts updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UserContactResponse"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestContacts"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/users/me/avatar": {
      "post": {
        "tags": ["images", "users"],
        "summary": "Upload current user avatar",
        "operationId": "uploadUserAvatar",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/ImageUploadRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserAvatarResponse"
                },
                "example": {
                  "avatarUrl": "https://res.cloudinary.com/demo/image/upload/prod_images/photo.jpg"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestImage"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "responses": {
      "BadRequest": {
        "description": "400 — validation failed",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/HttpError400Validation" }
          }
        }
      },
      "BadRequestImage": {
        "description": "400 — invalid or missing image file",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/HttpError400Image" },
            "examples": {
              "missingFile": {
                "summary": "File not sent",
                "value": {
                  "statusCode": 400,
                  "message": "File is required",
                  "error": "Bad Request"
                }
              },
              "invalidType": {
                "summary": "Not an image",
                "value": {
                  "statusCode": 400,
                  "message": "Only image files are allowed",
                  "error": "Bad Request"
                }
              }
            }
          }
        }
      },
      "BadRequestSlug": {
        "description": "400 — invalid event link code",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/HttpError400Slug" }
          }
        }
      },
      "BadRequestContacts": {
        "description": "400 — invalid contact value",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/HttpError400Contacts" }
          }
        }
      },
      "Unauthorized": {
        "description": "401 — missing or invalid JWT",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/HttpError401" }
          }
        }
      },
      "UnauthorizedInvalidCredentials": {
        "description": "401 — invalid email or password",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/HttpError401Credentials" }
          }
        }
      },
      "ConflictEmailRegistered": {
        "description": "409 — email already registered",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/HttpError409Email" }
          }
        }
      },
      "Forbidden": {
        "description": "403 — insufficient permissions",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/HttpError403" }
          }
        }
      },
      "ForbiddenOrganizer": {
        "description": "403 — ORGANIZER role required",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/HttpError403" }
          }
        }
      },
      "ForbiddenEventOwner": {
        "description": "403 — not the event owner",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/HttpError403" }
          }
        }
      },
      "ForbiddenNotRegistered": {
        "description": "403 — user is not registered for this event",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/HttpError403NotRegistered" }
          }
        }
      },
      "NotFound": {
        "description": "404 — resource not found",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/HttpError404" }
          }
        }
      },
      "NotFoundEvent": {
        "description": "404 — event not found",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/HttpError404Event" }
          }
        }
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "example": "password123"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "required": ["accessToken", "name", "contacts", "tags"],
        "properties": {
          "accessToken": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          },
          "name": {
            "type": "string",
            "example": "Jane Doe"
          },
          "contacts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserContactResponse"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Tag"
            }
          }
        },
        "example": {
          "accessToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
          "name": "Jane Doe",
          "contacts": [
            {
              "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
              "type": "TELEGRAM",
              "value": "@username"
            }
          ],
          "tags": [
            {
              "id": "c3d4e5f6-a7b8-9012-cdef-123456789012",
              "name": "frontend"
            }
          ]
        }
      },
      "Tag": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "frontend"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["statusCode", "message"],
        "properties": {
          "statusCode": { "type": "integer" },
          "message": {
            "oneOf": [
              { "type": "string" },
              { "type": "array", "items": { "type": "string" } }
            ]
          },
          "error": { "type": "string" }
        }
      },
      "HttpError400Validation": {
        "allOf": [{ "$ref": "#/components/schemas/ErrorResponse" }],
        "example": {
          "statusCode": 400,
          "message": ["title must be longer than or equal to 1 characters"],
          "error": "Bad Request"
        }
      },
      "HttpError400Image": {
        "allOf": [{ "$ref": "#/components/schemas/ErrorResponse" }],
        "example": {
          "statusCode": 400,
          "message": "Only image files are allowed",
          "error": "Bad Request"
        }
      },
      "HttpError400Slug": {
        "allOf": [{ "$ref": "#/components/schemas/ErrorResponse" }],
        "example": {
          "statusCode": 400,
          "message": "Invalid event link code",
          "error": "Bad Request"
        }
      },
      "HttpError400Contacts": {
        "allOf": [{ "$ref": "#/components/schemas/ErrorResponse" }],
        "example": {
          "statusCode": 400,
          "message": "Invalid email contact",
          "error": "Bad Request"
        }
      },
      "HttpError401": {
        "allOf": [{ "$ref": "#/components/schemas/ErrorResponse" }],
        "example": {
          "statusCode": 401,
          "message": "Unauthorized",
          "error": "Unauthorized"
        }
      },
      "HttpError401Credentials": {
        "allOf": [{ "$ref": "#/components/schemas/ErrorResponse" }],
        "example": {
          "statusCode": 401,
          "message": "Invalid credentials",
          "error": "Unauthorized"
        }
      },
      "HttpError409Email": {
        "allOf": [{ "$ref": "#/components/schemas/ErrorResponse" }],
        "example": {
          "statusCode": 409,
          "message": "Email already registered",
          "error": "Conflict"
        }
      },
      "HttpError403": {
        "allOf": [{ "$ref": "#/components/schemas/ErrorResponse" }],
        "example": {
          "statusCode": 403,
          "message": "Forbidden",
          "error": "Forbidden"
        }
      },
      "HttpError403NotRegistered": {
        "allOf": [{ "$ref": "#/components/schemas/ErrorResponse" }],
        "example": {
          "statusCode": 403,
          "message": "User is not registered for this event",
          "error": "Forbidden"
        }
      },
      "HttpError404": {
        "allOf": [{ "$ref": "#/components/schemas/ErrorResponse" }],
        "example": {
          "statusCode": 404,
          "message": "Not Found",
          "error": "Not Found"
        }
      },
      "HttpError404Event": {
        "allOf": [{ "$ref": "#/components/schemas/ErrorResponse" }],
        "example": {
          "statusCode": 404,
          "message": "Event not found",
          "error": "Not Found"
        }
      },
      "ImageUploadRequest": {
        "type": "object",
        "required": ["file"],
        "properties": {
          "file": {
            "type": "string",
            "format": "binary"
          }
        },
        "example": {
          "file": "photo.jpg"
        }
      },
      "ImageResponse": {
        "type": "object",
        "required": ["id", "url", "cloudinaryPublicId", "createdAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "url": { "type": "string", "format": "uri" },
          "cloudinaryPublicId": { "type": "string" },
          "originalFileName": { "type": "string", "nullable": true },
          "mimeType": { "type": "string", "nullable": true },
          "sizeBytes": { "type": "integer", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "example": {
          "id": "839c761d-80ce-41fe-bc9f-adb5a38c8429",
          "url": "https://res.cloudinary.com/demo/image/upload/prod_images/photo.jpg",
          "cloudinaryPublicId": "prod_images/839c761d-80ce-41fe-bc9f-adb5a38c8429",
          "originalFileName": "photo.jpg",
          "mimeType": "image/jpeg",
          "sizeBytes": 245760,
